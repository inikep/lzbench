#ifdef AOCL_ZSTD_OPT
/*
* Derived from AOCL_ZSTD_decodeSequence. Faster decompression for streams with constraints.
*/
FORCE_INLINE_TEMPLATE seq_t
@AOCL_ZSTD_DSF2_FUNC@(aocl_fast2_seqState_t* seqState, const ZSTD_longOffset_e longOffsets)
{
    seq_t seq;
    const ZSTD_seqSymbol* const llDInfo = seqState->stateLL.state_ptr;
    const ZSTD_seqSymbol* const mlDInfo = seqState->stateML.state_ptr;
    const ZSTD_seqSymbol* const ofDInfo = seqState->stateOffb.state_ptr;

    seq.matchLength = mlDInfo->baseValue;
    seq.litLength = llDInfo->baseValue;
    {
        BYTE const llBits = llDInfo->nbAdditionalBits;
        BYTE const mlBits = mlDInfo->nbAdditionalBits;
        BYTE const ofBits = ofDInfo->nbAdditionalBits;

        @AOCL_ZSTD_DSF2_INIT@

        assert(llBits <= MaxLLBits);
        assert(mlBits <= MaxMLBits);
        assert(ofBits <= MaxOff);

#ifdef AOCL_UNIT_TEST
        if (UNLIKELY((llBits + mlBits + ofBits) /* totalBits */ >= STREAM_ACCUMULATOR_MIN_64 - (LLFSELog+MLFSELog+OffFSELog)))
        {
            seq.litLength = 0; seq.matchLength = 0; seq.offset = 0;
            return seq; /* not FDS compliant */
        }
#else
        assert((llBits + mlBits + ofBits) /* totalBits */ < (STREAM_ACCUMULATOR_MIN_64 - (LLFSELog + MLFSELog + OffFSELog)));
#endif

        /* sequence */
        {
            size_t offset;
            @AOCL_ZSTD_DSF2_OFFSET@
            seq.offset = offset;
        }

        if (mlBits > 0)
            seq.matchLength += BIT_readBitsFast(&seqState->DStream, mlBits/*>0*/);

        /* Ensure there are enough bits to read the rest of data in 64-bit mode. */
        ZSTD_STATIC_ASSERT(16 + LLFSELog + MLFSELog + OffFSELog < STREAM_ACCUMULATOR_MIN_64);

        if (llBits > 0)
            seq.litLength += BIT_readBitsFast(&seqState->DStream, llBits/*>0*/);

    @AOCL_ZSTD_DSF2_UPDATE_FSE_STATE@
    }

    return seq;
}

#endif /* AOCL_ZSTD_OPT */
