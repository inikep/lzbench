# Set the default behavior
* text eol=lf

# Explicitly declare source files
*.c text eol=lf
*.h text eol=lf

# Denote files that should not be modified.
*.odt binary
*.png binary
*.jpg binary
*.bin binary

# vendored Rust crates: cargo checks every file against .cargo-checksum.json
misc/rust-codecs/vendor/** -text

# Visual Studio
*.sln binary
*.suo binary
*.vcxproj* binary

snappy/testdata/paper-100k.pdf binary
